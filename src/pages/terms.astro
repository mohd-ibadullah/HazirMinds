<div style="display:flex;flex-direction:column;gap:12px;padding-top:32px;border-top:1px solid #DED5C6"><p style="font-weight:600;font-size:15px">Other legal pages</p><div style="display:flex;flex-wrap:wrap;gap:8px 24px;font-size:16px"><a href="/privacy">Privacy Policy</a><a href="/ai-disclosure">AI Disclosure</a><a href="/accessibility">Accessibility Statement</a><a href="/free-website-terms">Free Static Website Terms</a></div></div>
</article>
