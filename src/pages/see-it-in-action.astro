---
import Base from '../layouts/Base.astro';
import DashboardTour from '../components/demos/DashboardTour.astro';
import SeeEstimators from '../components/demos/SeeEstimators.astro';
import OpportunityFinder from '../components/demos/OpportunityFinder.astro';
---
<Base title="See It in Action" description="See how HazirMinds works for yourself: tour the dashboard, estimate what missed calls cost you, and find where AI could help. Every demo uses sample data.">
<section aria-labelledby="h1" style="padding:clamp(32px,4vw,48px) 0 clamp(48px,6vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<nav aria-label="Breadcrumb" style="display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:clamp(32px,5vw,64px)"><a href="/">Home</a><span class="ms" aria-hidden="true" style="font-size:16px;color:#585E5A">chevron_right</span><span aria-current="page" style="color:#585E5A">See it in action</span></nav>
<div style="display:flex;flex-direction:column;gap:24px;max-width:780px">
<p style="font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#1D6B60">See it in action</p>
<h1 id="h1" style="font-weight:700;font-size:clamp(34px,4vw,48px);line-height:1.15;letter-spacing:-0.025em">See HazirMinds in action</h1>
<p style="font-size:clamp(18px,1.6vw,20px);line-height:1.6;color:#2F3633">See how it works for yourself. Every demo uses sample data.</p>
</div>
<nav aria-label="Demos on this page" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:32px">
<a class="x1" href="#tour" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;border:1px solid #DED5C6;background:#fff;color:#1A211F;font-weight:600;font-size:15px;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:20px;color:#0F4C45">ads_click</span>Product tour</a>
<a class="x2" href="#missed-calls" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;border:1px solid #DED5C6;background:#fff;color:#1A211F;font-weight:600;font-size:15px;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:20px;color:#0F4C45">phone_missed</span>Missed-call estimator</a>
<a class="x3" href="#time-back" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;border:1px solid #DED5C6;background:#fff;color:#1A211F;font-weight:600;font-size:15px;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:20px;color:#0F4C45">schedule</span>Time-back estimator</a>
<a class="x4" href="#opportunity-finder" style="display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;border:1px solid #DED5C6;background:#fff;color:#1A211F;font-weight:600;font-size:15px;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:20px;color:#0F4C45">travel_explore</span>Where could AI help?</a>
</nav>
</div>
</section>

<DashboardTour />

<SeeEstimators />

<OpportunityFinder />

<section aria-labelledby="cta-h" style="padding:0 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<div style="background:#F0EAE0;border-radius:24px;padding:clamp(40px,6vw,80px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:32px;align-items:center">
<div style="display:flex;flex-direction:column;gap:16px"><h2 id="cta-h" style="font-weight:700;font-size:clamp(30px,3.6vw,44px);line-height:1.12;letter-spacing:-0.025em;text-wrap:balance">Not sure where AI fits into your business yet?</h2><p style="font-size:clamp(17px,1.5vw,20px);line-height:1.6;color:#2F3633;max-width:48ch">That's exactly what the first conversation is for. No pressure, no pitch — just a look at what's possible for you.</p></div>
<div style="display:flex;flex-direction:column;gap:12px;align-items:flex-start"><a class="x5" href="/book-a-discovery-call" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;height:56px;padding:0 32px;border-radius:999px;background:#0F4C45;color:#FAF7F2;font-weight:600;font-size:17px;text-decoration:none">Book a Discovery Call<span class="ms" aria-hidden="true" style="font-size:20px">arrow_forward</span></a><span style="font-size:15px;color:#585E5A">A 15-minute call</span></div>
</div>
</div>
</section>

</Base>

<style>
.x1:hover{border-color:#0F4C45 !important;color:#0F4C45 !important}
.x2:hover{border-color:#0F4C45 !important;color:#0F4C45 !important}
.x3:hover{border-color:#0F4C45 !important;color:#0F4C45 !important}
.x4:hover{border-color:#0F4C45 !important;color:#0F4C45 !important}
.x5:hover{background:#0B3A35 !important;color:#FAF7F2 !important}
</style>
