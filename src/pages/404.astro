---
import Base from '../layouts/Base.astro';

---
<Base title="Page not found" description="" noindex>
<section aria-labelledby="h1" style="padding:clamp(56px,9vw,128px) 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(40px,5vw,72px);align-items:start">
<div style="display:flex;flex-direction:column;gap:24px">
<div aria-hidden="true" style="display:flex;align-items:center;gap:16px"><svg viewBox="14 18 92 84" width="48" height="44"><rect x="14" y="18" width="14" height="84" rx="7" fill="#DED5C6"></rect><rect x="33.5" y="49" width="14" height="22" rx="7" fill="#DED5C6"></rect><rect x="53" y="38" width="14" height="44" rx="7" fill="#B9852F"></rect><rect x="72.5" y="49" width="14" height="22" rx="7" fill="#DED5C6"></rect><rect x="92" y="18" width="14" height="84" rx="7" fill="#DED5C6"></rect></svg><span style="font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#1D6B60">Error 404</span></div>
<h1 id="h1" style="font-weight:700;font-size:clamp(38px,5vw,64px);line-height:1.08;letter-spacing:-0.03em;text-wrap:balance">We can't find that page</h1>
<p style="font-size:clamp(17px,1.5vw,19px);line-height:1.6;color:#2F3633;max-width:48ch">The link may be out of date, or the page may have moved. These will get you back on track.</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px">
<a class="x1" href="/" style="display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border-radius:999px;background:#0F4C45;color:#FAF7F2;font-weight:600;font-size:16px;text-decoration:none;transition:background .15s">Go to the home page</a>
<a class="x2" href="/book-a-discovery-call" style="display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border-radius:999px;border:1.5px solid #0F4C45;color:#0F4C45;font-weight:600;font-size:16px;text-decoration:none;transition:background .15s">Book a Discovery Call</a>
</div>
<p style="font-size:15px;line-height:1.6;color:#585E5A;margin-top:8px">Still stuck? Email <a href="mailto:contact@hazirminds.ai">contact@hazirminds.ai</a> or call <a href="tel:+19199247608">919-924-7608</a>.</p>
</div>
<nav aria-labelledby="pop-h" style="display:flex;flex-direction:column;gap:16px">
<h2 id="pop-h" style="font-weight:600;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#585E5A">Popular pages</h2>
<ul style="list-style:none;padding:0;display:flex;flex-direction:column;border-bottom:1px solid #DED5C6">
<li style="border-top:1px solid #DED5C6"><a class="x3" href="/services" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">widgets</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">Services</b><span style="font-size:14px;color:#585E5A">AI services and custom work</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
<li style="border-top:1px solid #DED5C6"><a class="x4" href="/see-it-in-action" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">play_circle</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">See it in action</b><span style="font-size:14px;color:#585E5A">Product tour and estimators, with sample data</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
<li style="border-top:1px solid #DED5C6"><a class="x5" href="/pricing" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">receipt_long</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">How pricing works</b><span style="font-size:14px;color:#585E5A">Custom pricing, simple terms</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
<li style="border-top:1px solid #DED5C6"><a class="x6" href="/security" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">shield_lock</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">Security &amp; Trust</b><span style="font-size:14px;color:#585E5A">How your data is protected</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
<li style="border-top:1px solid #DED5C6"><a class="x7" href="/industries" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">storefront</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">Industries</b><span style="font-size:14px;color:#585E5A">Who we work with</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
<li style="border-top:1px solid #DED5C6"><a class="x8" href="/about" style="display:flex;align-items:center;gap:16px;min-height:72px;padding:12px 4px;color:#1A211F;text-decoration:none"><span class="ms" aria-hidden="true" style="font-size:24px;color:#0F4C45">info</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:17px">About HazirMinds</b><span style="font-size:14px;color:#585E5A">Your AI solutions partner</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a></li>
</ul>
</nav>
</div>
</section>

</Base>

<style>
.x1:hover{background:#0B3A35 !important;color:#FAF7F2 !important}
.x2:hover{background:#E3EDE9 !important;color:#0B3A35 !important}
.x3:hover{color:#0F4C45 !important}
.x4:hover{color:#0F4C45 !important}
.x5:hover{color:#0F4C45 !important}
.x6:hover{color:#0F4C45 !important}
.x7:hover{color:#0F4C45 !important}
.x8:hover{color:#0F4C45 !important}
</style>
