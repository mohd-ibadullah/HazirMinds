<div style="display:flex;align-items:center;gap:12px;padding:12px 0;border-top:1px solid #EEE8DE"><span class="ms" aria-hidden="true" style="font-size:20px;color:#0F4C45">lock</span><dt style="font-size:14px;color:#585E5A;flex:1">In transit</dt><dd style="font-weight:600;font-size:14px">TLS encryption</dd></div>
