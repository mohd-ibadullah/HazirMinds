<li style="display:flex;gap:14px;padding:14px 0;border-top:1px solid #EEE8DE"><span class="ms" aria-hidden="true" style="font-size:22px;color:#0F4C45">notifications</span><div style="flex:1;min-width:0"><b style="font-size:15px">Team notification</b><p style="font-size:14px;color:#585E5A">Instantly · to your team</p></div><span style="display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 10px;border-radius:999px;background:#E5F0E8;color:#1E6B3E;font-weight:600;font-size:13px;white-space:nowrap"><span class="ms" aria-hidden="true" style="font-size:16px;color:#1E6B3E">check</span>Sent</span></li>
<li style="display:flex;gap:14px;padding:14px 0;border-top:1px solid #EEE8DE"><span class="ms" aria-hidden="true" style="font-size:22px;color:#A23E1E">forward_to_inbox</span><div style="flex:1;min-width:0"><b style="font-size:15px">Follow-up to Dana R.</b><p style="font-size:14px;color:#585E5A">Next morning · WhatsApp</p></div><span style="display:inline-flex;align-items:center;gap:4px;height:28px;padding:0 10px;border-radius:999px;background:#F7ECD6;color:#7A4E00;font-weight:600;font-size:13px;white-space:nowrap"><span class="ms" aria-hidden="true" style="font-size:16px;color:#7A4E00">schedule</span>Waiting for approval</span></li>
</ol></div>
</div>
</div>
