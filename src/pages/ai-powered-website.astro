---
import Base from '../layouts/Base.astro';
import AssistantDemo from '../components/demos/AssistantDemo.astro';
---
<Base title="AI-Powered Website" description="A custom AI-Powered Website for small and mid-size businesses, designed and built for you, with built-in AI chat and voice that capture and qualify visitors, answering only from your approved knowledge." current="services">
<section aria-labelledby="h1" style="padding:clamp(32px,4vw,48px) 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<nav aria-label="Breadcrumb" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:14px;margin-bottom:clamp(32px,5vw,64px)"><a href="/">Home</a><span class="ms" aria-hidden="true" style="font-size:16px;color:#585E5A">chevron_right</span><a href="/services">Services</a><span class="ms" aria-hidden="true" style="font-size:16px;color:#585E5A">chevron_right</span><span aria-current="page" style="color:#585E5A">AI-Powered Website</span></nav>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(40px,6vw,80px);align-items:center">
<div style="display:flex;flex-direction:column;gap:24px">
<p style="display:flex;align-items:center;gap:10px;font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#1D6B60"><span style="width:32px;height:32px;border-radius:8px;background:#DBE8F7;color:#2B5C8F;display:flex;align-items:center;justify-content:center"><span class="ms" aria-hidden="true" style="font-size:20px;color:#2B5C8F">language</span></span>AI service</p>
