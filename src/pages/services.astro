---
import Base from '../layouts/Base.astro';
import ServiceCards from '../components/demos/ServiceCards.astro';
import ServicePlanner from '../components/demos/ServicePlanner.astro';
---
<Base title="Services" description="AI services and custom work from one partner: AI Receptionist, AI-Powered Website, Automated Communications, Client Pipeline & Dashboard, and Secure, Managed Infrastructure." current="services">
<section aria-labelledby="h1" style="padding:clamp(32px,4vw,48px) 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<nav aria-label="Breadcrumb" style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:14px;margin-bottom:clamp(32px,5vw,64px)"><a href="/">Home</a><span class="ms" aria-hidden="true" style="font-size:16px;color:#585E5A">chevron_right</span><span aria-current="page" style="color:#585E5A">Services</span></nav>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:clamp(40px,6vw,80px);align-items:center">
<div style="display:flex;flex-direction:column;gap:24px">
<p style="font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#1D6B60">Services</p>
<h1 id="h1" style="font-weight:700;font-size:clamp(34px,4.4vw,56px);line-height:1.1;letter-spacing:-0.03em;text-wrap:balance">One partner for the full stack</h1>
<p style="font-size:clamp(17px,1.5vw,19px);line-height:1.6;color:#2F3633;max-width:52ch;text-wrap:pretty">Website, AI, integrations, automation, custom software, hosting and ongoing support. Start with one right-sized service, then grow based on real results.</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:8px">
<a class="x1" href="/book-a-discovery-call" style="display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border-radius:999px;background:#0F4C45;color:#FAF7F2;font-weight:600;font-size:16px;text-decoration:none;transition:background .15s,box-shadow .15s">Book a Discovery Call</a>
<a class="x2" href="#plan" style="display:inline-flex;align-items:center;justify-content:center;height:52px;padding:0 28px;border-radius:999px;border:1.5px solid #0F4C45;color:#0F4C45;font-weight:600;font-size:16px;text-decoration:none;transition:background .15s">Plan your starting point</a>
</div>
</div>

<nav aria-label="How the services fit together" style="background:#fff;border:1px solid #DED5C6;border-radius:16px;box-shadow:0 24px 64px rgba(15,76,69,.10),0 2px 6px rgba(26,33,31,.05);padding:clamp(20px,2.4vw,28px);display:flex;flex-direction:column;gap:10px">
<p style="font-weight:600;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#585E5A;margin-bottom:6px">How the services fit together</p>
<p style="font-weight:600;font-size:13px;color:#1D6B60">Front door</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:10px">
<a class="x3" href="#svc-rec" style="display:flex;align-items:center;gap:12px;min-height:56px;padding:12px 14px;border-radius:12px;background:#F5F1EA;color:#1A211F;text-decoration:none;font-weight:600;font-size:15px;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:22px;color:#0F6B57">call</span>AI Receptionist</a>
<a class="x4" href="#svc-web" style="display:flex;align-items:center;gap:12px;min-height:56px;padding:12px 14px;border-radius:12px;background:#F5F1EA;color:#1A211F;text-decoration:none;font-weight:600;font-size:15px;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:22px;color:#2B5C8F">language</span>AI-Powered Website</a>
</div>
<span class="ms" aria-hidden="true" style="align-self:center;font-size:20px;color:#B9852F">south</span>
<p style="font-weight:600;font-size:13px;color:#1D6B60">Follow-up</p>
<a class="x5" href="#svc-com" style="display:flex;align-items:center;gap:12px;min-height:56px;padding:12px 14px;border-radius:12px;background:#F5F1EA;color:#1A211F;text-decoration:none;font-weight:600;font-size:15px;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:22px;color:#A23E1E">forward_to_inbox</span>Automated Communications</a>
<span class="ms" aria-hidden="true" style="align-self:center;font-size:20px;color:#B9852F">south</span>
<p style="font-weight:600;font-size:13px;color:#1D6B60">One view</p>
<a class="x6" href="#svc-pipe" style="display:flex;align-items:center;gap:12px;min-height:56px;padding:12px 14px;border-radius:12px;background:#F5F1EA;color:#1A211F;text-decoration:none;font-weight:600;font-size:15px;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:22px;color:#8A5A00">view_kanban</span>Client Pipeline &amp; Dashboard</a>
<a class="x7" href="#svc-infra" style="display:flex;align-items:center;gap:12px;min-height:56px;margin-top:10px;padding:12px 14px;border-radius:12px;background:#0F4C45;color:#FAF7F2;text-decoration:none;font-weight:600;font-size:15px;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:22px;color:#D6A552">shield_lock</span><span style="flex:1">Secure, Managed Infrastructure</span><span style="font-weight:400;font-size:13px;color:#DCE7E4">Underneath everything</span></a>
</nav>
</div>
</div>
</section>

<ServiceCards />

<section aria-labelledby="cw-h" style="padding:0 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<div style="background:#0F4C45;color:#FAF7F2;border-radius:24px;padding:clamp(28px,5vw,64px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:clamp(32px,5vw,64px);align-items:start">
<div style="display:flex;flex-direction:column;gap:16px">
<p style="font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#DCE7E4">Custom work · quoted separately</p>
<h2 id="cw-h" style="font-weight:700;font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.02em;text-wrap:balance">When the standard service isn't the whole answer</h2>
<p style="font-size:18px;line-height:1.6;color:#DCE7E4;max-width:44ch">Custom work is scoped to the problem and quoted separately. A setup fee applies only when customization is required.</p>
</div>
<div style="display:flex;flex-direction:column;gap:12px">
<a class="x8" href="/custom-websites-mobile-apps" style="display:flex;align-items:center;gap:16px;padding:20px 24px;border-radius:16px;background:rgba(250,247,242,.08);border:1px solid rgba(250,247,242,.2);color:#FAF7F2;text-decoration:none;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:28px;color:#D6A552">devices</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:18px">Custom Websites &amp; Mobile Apps</b><span style="font-size:15px;line-height:1.5;color:#DCE7E4">Designed around how your business works</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a>
<a class="x9" href="/custom-integrations-software" style="display:flex;align-items:center;gap:16px;padding:20px 24px;border-radius:16px;background:rgba(250,247,242,.08);border:1px solid rgba(250,247,242,.2);color:#FAF7F2;text-decoration:none;transition:background .15s"><span class="ms" aria-hidden="true" style="font-size:28px;color:#D6A552">hub</span><span style="flex:1;display:flex;flex-direction:column;gap:2px"><b style="font-size:18px">Custom Integrations &amp; Software</b><span style="font-size:15px;line-height:1.5;color:#DCE7E4">Scoped to the problem</span></span><span class="ms" aria-hidden="true" style="font-size:22px">arrow_forward</span></a>
<p style="font-size:15px;line-height:1.55;color:#DCE7E4;padding:8px 4px 0">Also scoped separately: advanced automation and workflow redesign, and ongoing support and optimization.</p>
</div>
</div>
</div>
</section>

<ServicePlanner />

<section aria-labelledby="how-h" style="padding:clamp(48px,5.5vw,80px) 0">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<div style="display:flex;flex-direction:column;gap:16px;max-width:720px;margin-bottom:48px">
<p style="font-weight:600;font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#1D6B60">How we work</p>
<h2 id="how-h" style="font-weight:700;font-size:clamp(28px,3vw,40px);line-height:1.15;letter-spacing:-0.02em">Every service starts the same way</h2>
</div>
<ol style="list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:24px">
<li style="display:flex;flex-direction:column;gap:16px;padding-top:24px;border-top:2px solid #2B5C8F"><span style="font-weight:700;font-size:15px;color:#2B5C8F">Step 1</span><h3 style="font-weight:600;font-size:20px;line-height:1.3">Understand</h3><p style="font-size:16px;line-height:1.6;color:#2F3633">We learn your business and your actual challenges first.</p></li>
<li style="display:flex;flex-direction:column;gap:16px;padding-top:24px;border-top:2px solid #8A5A00"><span style="font-weight:700;font-size:15px;color:#8A5A00">Step 2</span><h3 style="font-weight:600;font-size:20px;line-height:1.3">Identify</h3><p style="font-size:16px;line-height:1.6;color:#2F3633">We find where AI can genuinely create value for you.</p></li>
<li style="display:flex;flex-direction:column;gap:16px;padding-top:24px;border-top:2px solid #A23E1E"><span style="font-weight:700;font-size:15px;color:#A23E1E">Step 3</span><h3 style="font-weight:600;font-size:20px;line-height:1.3">Start Small</h3><p style="font-size:16px;line-height:1.6;color:#2F3633">We implement one right-sized solution — no big upfront commitment.</p></li>
<li style="display:flex;flex-direction:column;gap:16px;padding-top:24px;border-top:2px solid #0F6B57"><span style="font-weight:700;font-size:15px;color:#0F6B57">Step 4</span><h3 style="font-weight:600;font-size:20px;line-height:1.3">Grow</h3><p style="font-size:16px;line-height:1.6;color:#2F3633">We measure the results, then expand based on what you actually need next.</p></li>
</ol>
</div>
</section>

<section aria-labelledby="cta-h" style="padding:0 0 clamp(48px,5.5vw,80px)">
<div style="max-width:1296px;margin:0 auto;padding:0 clamp(24px,4vw,48px)">
<div style="background:#0F4C45;color:#FAF7F2;border-radius:24px;padding:clamp(40px,6vw,80px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:32px;align-items:center">
<div style="display:flex;flex-direction:column;gap:16px"><h2 id="cta-h" style="font-weight:700;font-size:clamp(30px,3.6vw,44px);line-height:1.12;letter-spacing:-0.025em;text-wrap:balance">Not sure where AI fits into your business yet?</h2><p style="font-size:clamp(17px,1.5vw,20px);line-height:1.6;color:#DCE7E4;max-width:48ch">That's exactly what the first conversation is for. No pressure, no pitch — just a look at what's possible for you.</p></div>
<div style="display:flex;flex-direction:column;align-items:center;gap:12px;width:fit-content"><a class="x10" href="/book-a-discovery-call" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;height:56px;padding:0 32px;border-radius:999px;background:#FAF7F2;color:#0F4C45;font-weight:600;font-size:17px;text-decoration:none;transition:background .15s">Book a Discovery Call<span class="ms" aria-hidden="true" style="font-size:20px">arrow_forward</span></a><span style="display:inline-flex;align-items:center;gap:6px;font-size:15px;color:#DCE7E4"><span class="ms" aria-hidden="true" style="font-size:18px;color:#DCE7E4">schedule</span>A 15-minute call</span></div>
</div>
</div>
</section>

</Base>

<style>
.x1:hover{background:#0B3A35 !important;color:#FAF7F2 !important;box-shadow:0 12px 32px rgba(15,76,69,.18) !important}
.x2:hover{background:#E3EDE9 !important;color:#0B3A35 !important}
.x3:hover{background:#E3EDE9 !important;color:#0F4C45 !important}
.x4:hover{background:#E3EDE9 !important;color:#0F4C45 !important}
.x5:hover{background:#E3EDE9 !important;color:#0F4C45 !important}
.x6:hover{background:#E3EDE9 !important;color:#0F4C45 !important}
.x7:hover{background:#0B3A35 !important;color:#FAF7F2 !important}
.x8:hover{background:rgba(250,247,242,.14) !important;color:#FAF7F2 !important}
.x9:hover{background:rgba(250,247,242,.14) !important;color:#FAF7F2 !important}
.x10:hover{background:#E3EDE9 !important;color:#0B3A35 !important}
</style>
