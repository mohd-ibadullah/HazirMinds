---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Highlights the matching item in the main nav */
  current?: '' | 'services' | 'industries' | 'security' | 'pricing' | 'about';
  noindex?: boolean;
  primaryLabel?: string; primaryHref?: string; secondaryLabel?: string; secondaryHref?: string; mobilePrimary?: string;
}
const { title, description, current = '', noindex = false, primaryLabel, primaryHref, secondaryLabel, secondaryHref, mobilePrimary } = Astro.props;
const fullTitle = title.includes('Hazirminds') ? title : `${title} | Hazirminds`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hazirminds" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0F4C45" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Fraunces:ital,opsz,wght@1,9..144,500&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,300,0,0&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header {...{ current, primaryLabel, primaryHref, secondaryLabel, secondaryHref, mobilePrimary }} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
