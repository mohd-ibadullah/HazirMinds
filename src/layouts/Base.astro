---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contact, services, customWork, social, areaServed } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Highlights the matching item in the main nav */
  current?: '' | 'services' | 'industries' | 'security' | 'pricing' | 'about';
  noindex?: boolean;
  primaryLabel?: string; primaryHref?: string; secondaryLabel?: string; secondaryHref?: string; mobilePrimary?: string;
}
const { title, description, current = '', noindex = false, primaryLabel, primaryHref, secondaryLabel, secondaryHref, mobilePrimary } = Astro.props;
const fullTitle = title.includes('Hazirminds') ? title : `${title} | Hazirminds`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Business identity for search engines and AI assistants. Keep in step with the Google Business Profile.
const siteUrl = new URL('/', Astro.site).href;
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': siteUrl + '#business',
  name: 'HazirMinds',
  alternateName: 'Hazirminds',
  url: siteUrl,
  logo: new URL('/icon.svg', Astro.site).href,
  description: 'HazirMinds is an AI solutions partner for businesses and organizations in every industry. We design, build and manage AI receptionists, AI-powered websites, automated follow-up and a lead pipeline dashboard.',
  telephone: '+1-919-924-7608',
  email: contact.email,
  areaServed: [...areaServed],
  sameAs: [...social],
  makesOffer: [...services, ...customWork].map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name, description: s.line, url: new URL(s.href, Astro.site).href } })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hazirminds" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://hazirminds.ai/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://hazirminds.ai/og.png" />
    <meta name="theme-color" content="#0F4C45" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Fraunces:ital,opsz,wght@1,9..144,500&family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,300,0,0&display=swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header {...{ current, primaryLabel, primaryHref, secondaryLabel, secondaryHref, mobilePrimary }} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
