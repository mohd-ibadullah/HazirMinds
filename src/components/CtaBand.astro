---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; href?: string; label?: string; note?: string; padTop?: boolean }
const {
  title = 'Not sure where AI fits into your business yet?',
  text = "That's exactly what the first conversation is for. No pressure, no pitch — just a look at what's possible for you.",
  href = '/book-a-discovery-call', label = 'Book a Discovery Call', note = 'A 15-minute call', padTop = true,
} = Astro.props;
---
<section class="section" style={padTop ? undefined : 'padding-top:0'} aria-labelledby="cta-h">
  <div class="container">
    <div class="cta bg-dark">
      <div class="stack">
        <h2 id="cta-h" class="cta-title">{title}</h2>
        <p class="cta-text">{text}</p>
      </div>
      <div class="cta-action">
        <a class="btn btn-light" href={href} style="min-height:56px;padding:0 32px;font-size:17px">{label}<Icon name="arrow_forward" /></a>
        <span class="cta-note"><Icon name="schedule" size={18} />{note}</span>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { border-radius: 24px; padding: clamp(40px, 6vw, 80px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 32px; align-items: center; }
  .cta-title { font-weight: 700; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.12; letter-spacing: -.025em; text-wrap: balance; }
  .cta-text { font-size: clamp(17px, 1.5vw, 20px); line-height: 1.6; color: var(--on-dark); max-width: 48ch; }
  .cta-action { display: flex; flex-direction: column; align-items: center; gap: 12px; width: fit-content; }
  .cta-note { display: inline-flex; align-items: center; gap: 6px; font-size: 15px; color: var(--on-dark); }
</style>
