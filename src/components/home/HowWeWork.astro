---
const steps = [
  { c: 'web', name: 'Understand', text: 'We learn your business and your actual challenges first.' },
  { c: 'pipe', name: 'Identify', text: 'We find where AI can genuinely create value for you.' },
  { c: 'com', name: 'Start Small', text: 'We implement one right-sized solution — no big upfront commitment.' },
  { c: 'rec', name: 'Grow', text: 'We measure the results, then expand based on what you actually need next.' },
];
---
<section class="hww" aria-labelledby="hw-h" data-hww>
  <div class="hww-sticky">
    <div class="container hww-grid">
      <div class="stack">
        <p class="eyebrow">How we work</p>
        <h2 id="hw-h" class="h2 h2-lg">We start with your business, not the technology</h2>
        <p class="body-lg" style="max-width:44ch">We follow a structured process for every client — nothing is built ad-hoc or rushed.</p>
        <div class="progress" aria-hidden="true">{steps.map((s) => <span class={'c-' + s.c}></span>)}</div>
        <p class="small progress-label" style="font-size:14px" data-step-label>Step 1 of 4</p>
      </div>
      <ol class="hsteps">
        {steps.map((s, i) => (
          <li class={'c-' + s.c + (i === 0 ? ' is-on' : '')}>
            <span class="n">{i + 1}</span>
            <div><h3>{s.name}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .hww { padding: var(--section) 0; }
  .hww-grid { display: grid; gap: 32px; }
  .progress, .progress-label { display: none; }
  .hsteps { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .hsteps li { display: flex; gap: 20px; padding: 18px 24px; border-radius: 16px; border: 1px solid transparent; transition: opacity .3s, background .3s, border-color .3s; }
  .n { width: 48px; height: 48px; border-radius: 50%; flex: none; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 18px; border: 1.5px solid var(--tint); background: var(--tint); color: #fff; transition: background .3s, color .3s; }
  .hsteps h3 { font-weight: 600; font-size: 22px; line-height: 1.3; letter-spacing: -.01em; }
  .hsteps p { font-size: 16px; line-height: 1.55; color: var(--ink-2); margin-top: 4px; }
  @media (min-width: 900px) { .hww-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 64px; align-items: center; } }

  .hww:global(.is-sticky) { height: 240vh; padding: 0; position: relative; }
  .hww:global(.is-sticky) .hww-sticky { position: sticky; top: 64px; padding: clamp(24px, 4vh, 48px) 0; }
  .hww:global(.is-sticky) .progress { display: flex; gap: 8px; margin-top: 24px; max-width: 320px; }
  .hww:global(.is-sticky) .progress-label { display: block; }
  .progress span { height: 4px; flex: 1; border-radius: 2px; background: var(--line); transition: background .3s; }
  .progress span:global(.is-done) { background: var(--tint); }
  .hww:global(.is-sticky) .hsteps li { opacity: .42; }
  .hww:global(.is-sticky) .hsteps li:not(:global(.is-on)):not(:global(.is-done)) .n { background: transparent; color: var(--tint); }
  .hww:global(.is-sticky) .hsteps li:global(.is-on) { opacity: 1; background: #fff; border-color: var(--line); }
</style>
<script>
  const sec = document.querySelector<HTMLElement>('[data-hww]');
  if (sec) {
    const items = Array.from(sec.querySelectorAll<HTMLElement>('.hsteps li'));
    const bars = Array.from(sec.querySelectorAll<HTMLElement>('.progress span'));
    const label = sec.querySelector<HTMLElement>('[data-step-label]')!;
    const mq = matchMedia('(min-width: 900px) and (min-height: 720px) and (prefers-reduced-motion: no-preference)');
    let step = -1;
    const set = (s: number) => {
      if (s === step) return; step = s;
      items.forEach((el, i) => { el.classList.toggle('is-on', i === s); el.classList.toggle('is-done', i < s); });
      bars.forEach((b, i) => b.classList.toggle('is-done', i <= s));
      label.textContent = `Step ${s + 1} of ${items.length}`;
    };
    const onScroll = () => {
      if (!sec.classList.contains('is-sticky')) return;
      const r = sec.getBoundingClientRect(), span = r.height - innerHeight;
      if (span > 0) set(Math.floor(Math.min(.999, Math.max(0, -r.top / span)) * items.length));
    };
    const apply = () => { sec.classList.toggle('is-sticky', mq.matches); step = -1; set(0); onScroll(); };
    mq.addEventListener('change', apply);
    addEventListener('scroll', onScroll, { passive: true });
    apply();
  }
</script>
