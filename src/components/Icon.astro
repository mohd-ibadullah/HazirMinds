---
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size, class: cls = '', label } = Astro.props;
---
<span class={'ms ' + cls} style={size ? `font-size:${size}px` : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label} role={label ? 'img' : undefined}>{name}</span>
