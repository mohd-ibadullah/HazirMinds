{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "cleanUrls": true,
  "redirects": [
    { "source": "/industries/hvac", "destination": "/industries", "permanent": true },
    { "source": "/industries/hvac/", "destination": "/industries", "permanent": true },
    { "source": "/industries/dental", "destination": "/industries", "permanent": true },
    { "source": "/industries/dental/", "destination": "/industries", "permanent": true },
    { "source": "/industries/restaurant", "destination": "/industries", "permanent": true },
    { "source": "/industries/restaurant/", "destination": "/industries", "permanent": true },
    { "source": "/industries/realestate", "destination": "/industries", "permanent": true },
    { "source": "/industries/realestate/", "destination": "/industries", "permanent": true },
    { "source": "/industries/auto", "destination": "/industries", "permanent": true },
    { "source": "/industries/auto/", "destination": "/industries", "permanent": true },
    { "source": "/industries/ecommerce", "destination": "/industries", "permanent": true },
    { "source": "/industries/ecommerce/", "destination": "/industries", "permanent": true },
    { "source": "/industries/proservices", "destination": "/industries", "permanent": true },
    { "source": "/industries/proservices/", "destination": "/industries", "permanent": true },
    { "source": "/industries/automotive-fleet", "destination": "/industries", "permanent": true },
    { "source": "/industries/beauty-wellness-personal-care", "destination": "/industries", "permanent": true },
    { "source": "/industries/business-services-agencies", "destination": "/industries", "permanent": true },
    { "source": "/industries/education-nonprofits-community", "destination": "/industries", "permanent": true },
    { "source": "/industries/financial-professional-services", "destination": "/industries", "permanent": true },
    { "source": "/industries/food-hospitality-events", "destination": "/industries", "permanent": true },
    { "source": "/industries/healthcare-dental", "destination": "/industries", "permanent": true },
    { "source": "/industries/home-field-services", "destination": "/industries", "permanent": true },
    { "source": "/industries/legal", "destination": "/industries", "permanent": true },
    { "source": "/industries/real-estate-property", "destination": "/industries", "permanent": true },
    { "source": "/industries/retail-ecommerce-order-taking", "destination": "/industries", "permanent": true },
    { "source": "/case-studies", "destination": "/see-it-in-action", "permanent": true },
    { "source": "/case-studies/", "destination": "/see-it-in-action", "permanent": true },
    { "source": "/demo", "destination": "/see-it-in-action", "permanent": true },
    { "source": "/demo/", "destination": "/see-it-in-action", "permanent": true },
    { "source": "/compare", "destination": "/pricing", "permanent": true },
    { "source": "/compare/", "destination": "/pricing", "permanent": true },
    { "source": "/chief-of-staff", "destination": "/services", "permanent": true },
    { "source": "/chief-of-staff/", "destination": "/services", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
