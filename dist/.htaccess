# ============================================================================
#  HazirMinds — Apache configuration for cPanel shared hosting (SpaceShip).
#
#  build.js copies this file to dist/.htaccess, so it travels with the site when
#  you upload the contents of dist/ into public_html.
#
#  Canonical origin: https://hazirminds.ai  (matches site.url, every
#  <link rel="canonical">, the og: tags and every URL in sitemap.xml).
#  Canonical path form: slashless  (/about, not /about/).
# ============================================================================

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
#  1. Canonical host — force HTTPS and drop the www prefix, in one hop.
#     Skipped on localhost so the local dev server still works.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.hazirminds\.ai$ [NC]
  RewriteRule ^ https://hazirminds.ai%{REQUEST_URI} [R=301,L]

  # -------------------------------------------------------------------------
  #  2. Canonical path form. /about/ -> /about, so one page never answers on
  #     two URLs. (The rules below then serve /about from /about/index.html.)
  # -------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ /%1 [R=301,L]

  # -------------------------------------------------------------------------
  #  2b. Industry taxonomy change (2026): the eight flat trade pages became
  #      eleven umbrella industries. Each old URL 301s to the umbrella that
  #      absorbed it. These MUST stay above rule 3 — the slashless rewrite
  #      would otherwise map /industries/hvac onto a file that no longer
  #      exists and answer 404 instead of redirecting.
  #      Mirrors `legacy` in src/data/industries.js; build.js asserts they match.
  # -------------------------------------------------------------------------
  RewriteRule ^industries/hvac/?$ /industries/home-field-services [R=301,L]
  RewriteRule ^industries/dental/?$ /industries/healthcare-dental [R=301,L]
  RewriteRule ^industries/restaurant/?$ /industries/food-hospitality-events [R=301,L]
  RewriteRule ^industries/realestate/?$ /industries/real-estate-property [R=301,L]
  RewriteRule ^industries/auto/?$ /industries/automotive-fleet [R=301,L]
  RewriteRule ^industries/ecommerce/?$ /industries/retail-ecommerce-order-taking [R=301,L]
  RewriteRule ^industries/proservices/?$ /industries/business-services-agencies [R=301,L]

  # -------------------------------------------------------------------------
  #  3. Slashless pretty URLs. /about -> /about/index.html, rewritten
  #     internally so the address bar keeps the canonical form and no redirect
  #     is spent on it.
  # -------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

# ---------------------------------------------------------------------------
#  4. Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
#  5. Caching.
#     main.css and main.js are requested with a content hash (?v=...), and the
#     images and fonts are built from versioned source files, so those can be
#     cached hard. HTML must always revalidate or a deploy would not show up.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 day"

  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/plain                    "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 0 seconds"
  ExpiresByType text/xml                      "access plus 0 seconds"

  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType text/javascript               "access plus 1 year"

  ExpiresByType image/webp                    "access plus 1 month"
  ExpiresByType image/jpeg                    "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 month"
  ExpiresByType image/svg+xml                 "access plus 1 month"
  ExpiresByType image/x-icon                  "access plus 1 month"

  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType font/woff                     "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Stale-while-revalidate keeps repeat visits instant without ever pinning an old HTML file.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # -------------------------------------------------------------------------
  #  6. Security headers.
  #     Deliberately NO Content-Security-Policy: the built pages use inline
  #     <style> blocks and inline style attributes throughout, so a policy
  #     strict enough to be useful would break the layout. Add one only
  #     together with nonce/hash plumbing in the build.
  # -------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # Never leak the PHP version.
  Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
#  7. Correct types for the asset formats the site actually ships.
# ---------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType font/woff2                .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------------------
#  8. Block the things that should never be public.
# ---------------------------------------------------------------------------
<FilesMatch "^\.(git|gitignore|vercelignore|env|htaccess~)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^(?:src|qa|audit|ui-evidence|visual-plan|deploy)/ - [F,L]
</IfModule>
